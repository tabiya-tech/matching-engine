# Github Secrets
MONGO_URL='<mongo db uri>'
MONGO_DB_NAME='<mongo db name>'
MONGO_JOBS_COLLECTION='<mongo db collection>'
GEMINI_API_KEY='<gemini api key>'
# Optional: Langfuse tracing of /match* requests (see backend/README.md "Request tracing").
MATCHING_LANGFUSE_PUBLIC_KEY=
MATCHING_LANGFUSE_SECRET_KEY=

# Github Env vars
# The language this deployment matches in ('en' | 'es', or a locale like 'AR-es'). It selects
# the cross-encoder checkpoint, the BM25 stopwords and the labels echoed back; nothing on the
# request can change it. Unset means 'en'.
TARGET_LANGUAGE=en
SCORING_MODE=multiplicative
ADDITIVE_W1_SKILLS=0.40
ADDITIVE_W2_PREFERENCE=0.40
ADDITIVE_W3_MARKET=0.20
MATCH_TOP_K_OPPORTUNITIES=5
MATCH_TOP_K_OCCUPATIONS=5
MATCH_TOP_K_SKILL_GAPS=5
GATE_SIMILARITY_THRESHOLD=0.35
PHAT_ALPHA_ESSENTIAL=0.5
PHAT_BETA_READINESS=0.2
PHAT_GAMMA_MARKET=0.3
SKILL_U_W_LOC=0.20
SKILL_U_W_ESS=0.50
SKILL_U_W_OPT=0.20
SKILL_U_W_GRP=0.10
SKILL_U_GAP_PENALTY=0.50
SKILL_U_TAU_ELIG=0.35
SKILL_MIN_ESSENTIAL_MATCH_SHARE=1.0
SKILL_ESSENTIAL_GEO_FLOOR=0.000001
PREFERENCE_BASE_CONSTANT=0.5
PREFERENCE_LEGACY_SCORE_SCALE=0.2
PREFERENCE_SIGMOID_NUMERATOR=4.0
PREF_ENABLE_EARNINGS=true
PREF_ENABLE_TASK_CONTENT=false
PREF_ENABLE_PHYSICAL_DEMAND=true
PREF_ENABLE_WORK_FLEXIBILITY=false
PREF_ENABLE_SOCIAL=true
PREF_ENABLE_CAREER_GROWTH=true
PREF_ENABLE_SOCIAL_MEANING=false
EMBEDDING_MODEL_PATH=resources/models/skill_embedding_model.pt
SKILL_TO_ROW_PATH=resources/models/skill_to_row.json
# Leave the taxonomy / occupation paths EMPTY. They now live per language under
# resources/skill_taxonomy/<lang>/ and resources/occupations/<lang>/ and are picked from
# TARGET_LANGUAGE; setting one of these pins EVERY language to that single file, which stops
# the Spanish label pack from loading (and the old flat paths no longer exist).
OCCUPATION_JSON_PATH=
SKILLS_CSV_PATH=
SKILL_GROUPS_CSV_PATH=
SKILL_HIERARCHY_CSV_PATH=
SKILL_ESSENTIAL_DAMPING_ALPHA=0.0
JOBS_RETRIEVAL_FILTER=true
# Optional (defaults to false when unset): true drops occupation_recommendations from /match_v4 and
# /experiments/v5/match and skips the occupation pipeline entirely.
MATCH_V4_DISABLE_OCCUPATIONS=false
# Optional (both default to true when unset).
# MATCH_APPLY_LOCATION_FILTER=false skips the in-memory location gate before scoring.
MATCH_APPLY_LOCATION_FILTER=true
# LOCATION_TIER_ENABLED=false restores strict same-county pool + scoring on /match_v4 and
# /experiments/v5/match (instant rollback of the tiered urban-pull matching).
LOCATION_TIER_ENABLED=true
# Mongo load cap, only in effect while JOBS_RETRIEVAL_FILTER=true (0 = uncapped).
JOBS_RETRIEVAL_LIMIT=10000
# Soft tier multipliers on /match_v4 (local=1.0, off-chain=0). Ignored when LOCATION_TIER_ENABLED=false;
# set both to 1.0 to keep the tiering on but stop it from preferring local jobs.
LOCATION_TIER_W_REGIONAL=0.70
LOCATION_TIER_W_NATIONAL=0.50
# /match_v4 funnel width: stage-1 cosine shortlist -> cross-encoder slate. Raise together with a
# widened pool (JOBS_RETRIEVAL_FILTER=false), or the extra jobs never reach the CE.
MATCH_V4_RETRIEVE_TOP_K=100
MATCH_V4_FINAL_TOP_K=50
# Optional (tracing stays off when unset). MATCHING_TRACING_ENVIRONMENT defaults to the stack name.
MATCHING_ENABLE_TRACING=false
MATCHING_LANGFUSE_HOST=https://cloud.langfuse.com
MATCHING_TRACING_CONFIG=
