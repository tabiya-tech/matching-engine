# Copy to .env and adjust. Paths are relative to backend/ unless absolute.
# Used by the API, tests, and run_local.py (run_local also loads this file).

# --- MongoDB (required for API; run_local sets dummy values) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=matching_service
# TLS / Atlas on macOS: if you see "SSL: CERTIFICATE_VERIFY_FAILED / unable to get local issuer certificate",
# set this so PyMongo uses Mozilla's CA bundle (pip install certifi):
# MONGO_TLS_CA_FILE=certifi
# Last-resort LOCAL ONLY (never in prod): skips TLS verification entirely
# MONGO_TLS_INSECURE=1
# API reads job postings from this collection (enriched: onet_work_activities + skill_groups_origin_uuids on each doc)
MONGO_JOBS_COLLECTION=RankedJobsEnriched
# Client server selection timeout (ms); default 30000 if unset
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# Motor connection pool (passed to PyMongo). Tune for concurrent /match load.
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=0
# Filter: { is_active: true } — index { is_active: 1 } in Mongo for latency
# /match: optional active+location+remote prefilter (union of users), cap, then in-memory
# _job_matches_user_location. Set JOBS_RETRIEVAL_FILTER=0 to load all active (scripts, debugging).
# JOBS_RETRIEVAL_FILTER=1
# JOBS_RETRIEVAL_LIMIT=10000
# Inclusion projection on job find (smaller BSON over the wire). Set to 0 if a field is missing at runtime.
# JOBS_FIND_USE_PROJECTION=1
# In-memory location gate before scoring (matching_service._job_matches_user_location).
# MATCH_APPLY_LOCATION_FILTER=1
# Kill-switch for occupation recommendations on the v4 engine (/match_v4 and /experiments/v5/match):
# 1 returns an empty occupation_recommendations list and skips the whole occupation pipeline (corpus
# load, embeddings, retrieval, CE rerank). Opportunities, skill gaps and /match|/match_v2|/match_v3
# are unaffected.
# MATCH_V4_DISABLE_OCCUPATIONS=0

# Startup warmup (not per /match). Set to 0 to skip a step. WA lookup is off by default (enriched jobs).
# MONGO_WARMUP_ON_STARTUP=1
# Create the jobs collection indexes on startup (browse/stats/match performance). Set 0 to skip
# (e.g. when the DB user lacks createIndex rights); run `python -m scripts.create_indexes` instead.
# ENSURE_INDEXES_ON_STARTUP=1
# WARMUP_OCCUPATIONS_CACHE=1
# WARMUP_WA_LOOKUP=0
# Preload CosineSkillMatcher + HuggingFace CrossEncoder at startup (off by default; first /match_v3 or /match_v4 carries the cost otherwise).
# WARMUP_MATCH_V3_MODELS=1
# If 1, run warmup in a background task so the process binds immediately (first /match may be colder).
# WARMUP_NON_BLOCKING=0

# --- Offline HF (avoid HEAD/GET to huggingface.co on every CrossEncoder load) ---
# Once the model is cached under ~/.cache/huggingface, set both to 1 to skip update checks.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# --- Local batch script (run_local.py only) ---
# Default: repo root data/supply.jsonl and data/demand.jsonl
# SUPPLY_JSONL_PATH=
# DEMAND_JSONL_PATH=

# --- Language ---
# The deployment's language (app/languages/). Nothing on the request selects it: set it here
# per deployment. Skill resolution is language-neutral anyway — every enabled language's
# taxonomy label pack is mapped onto the same embedding id space, so a Spanish posting
# matches a Spanish profile regardless. TARGET_LANGUAGE only selects the cross-encoder
# checkpoint, the BM25 stopwords, and the labels echoed back.
#
# 'en' | 'es', or a locale like 'AR-es'. Default: en.
# TARGET_LANGUAGE=en
# Label packs loaded into the resolver. Default: all registered languages (cheap — a CSV
# parse, no model). The canonical language ('en') is always included.
# ENABLED_LANGUAGES=en,es

# --- Scoring mode ---
SCORING_MODE=multiplicative

# Additive mode weights (when SCORING_MODE=additive)
ADDITIVE_W1_SKILLS=0.40
ADDITIVE_W2_PREFERENCE=0.40
ADDITIVE_W3_MARKET=0.20

# --- Cosine batch + cross-encoder rerank (`run_cosine_matching --cross-encoder-rerank`) ---
# CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Per-language override — the reranker scores skill-label text, so the checkpoint has to
# understand the language. Also used by /match_v3 and /match_v4.
# CROSS_ENCODER_MODEL_NAME_ES=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# An image may also vendor checkpoints locally, tried before the HF name:
#   resources/models/cross-encoder/<repo-name>/   (what setup.sh downloads, one per language:
#     .../cross-encoder/ms-marco-MiniLM-L-6-v2, .../cross-encoder/mmarco-mMiniLMv2-L12-H384-v1)
#   resources/models/cross-encoder-<lang>/       (also accepted)
#   resources/models/cross-encoder/              (legacy flat layout, en only)
# CROSS_ENCODER_BATCH_SIZE=16
# COSINE_CROSS_ENCODER_RETRIEVE_TOP_K=50

# --- Hybrid BM25 × cosine (`python -m app.services.hybrid_scoring.run_bm25_cosine_hybrid`) ---
# Pool fusion: alpha * norm(mean_best_cosine) + (1 - alpha) * norm(BM25). Higher alpha = more cosine.
# CLI `--alpha-on-cosine` overrides. Loaded via dotenv when you run the module from backend/.
HYBRID_ALPHA_ON_COSINE=0.5
# ALPHA_ON_COSINE=0.5

# --- Match HTTP /match_v2 (BM25 × cosine hybrid, same corpus fetch as /match) ---
MATCH_V2_HYBRID_TOP_K=20
MATCH_V2_MAX_USERS_PER_REQUEST=32

# --- Match list sizes ---
MATCH_TOP_K_OPPORTUNITIES=5
MATCH_TOP_K_OCCUPATIONS=5
MATCH_TOP_K_SKILL_GAPS=5

# --- Gate & success propensity (p_hat) ---
GATE_SIMILARITY_THRESHOLD=0.35
# Response filter for scored skill outputs:
# - essential_skill_matches similarity
# - skill_gap_recommendations proximity_score
# Defaults to GATE_SIMILARITY_THRESHOLD when unset.
# MATCH_RESPONSE_SKILL_MIN_SCORE=0.35
PHAT_ALPHA_ESSENTIAL=0.5
PHAT_BETA_READINESS=0.2
PHAT_GAMMA_MARKET=0.3

# --- Skill utility / feasibility (U) ---
SKILL_U_W_LOC=0.20
SKILL_U_W_ESS=0.50
SKILL_U_W_OPT=0.20
SKILL_U_W_GRP=0.10
SKILL_U_GAP_PENALTY=0.50
SKILL_U_TAU_ELIG=0.35
SKILL_MIN_ESSENTIAL_MATCH_SHARE=1.0
SKILL_ESSENTIAL_GEO_FLOOR=0.000001
# Score-weighted geometric mean for essential_fit. 0 = naive GM (current behaviour);
# >0 dampens influence of low row-max scores via weight = rowmax**alpha. Try 0.5 or 1.0.
SKILL_ESSENTIAL_DAMPING_ALPHA=0.0

# --- Per-rowmax rescaling target ---
# Whitened cosine for distinct skills sits in a narrow [0, ~0.3] working band; identity
# matches sit at 1.0 (tautological). To use the full [0, 1] discriminative range, every
# rowmax (per-essential best user-skill cosine) gets rescaled to min(1, rowmax / target)
# before the score-weighted GM. Identity rowmaxes clip to 1.0; non-identity stretch.
# Default lives in the whitened artefact's metadata (key: target_max_p999, computed
# at build time as p99.9 of 1M random-pair cosines). Set this env var to override.
# SKILL_RESCALE_TARGET=0.3

# --- Preferences (base + sigmoid + legacy scale) ---
PREFERENCE_BASE_CONSTANT=0.5
PREFERENCE_LEGACY_SCORE_SCALE=0.2
PREFERENCE_SIGMOID_NUMERATOR=4.0
# unified = DCE betas + BWS additive-RUM (preference_score_v1/, default); legacy = old beta+sigmoid
# (preference_score.py, A/B escape hatch). "hybrid_v1" is accepted as a deprecated alias for unified.
PREFERENCE_SCORER_MODE=unified
# POST /match_v4 final rank: product = u_hat * p_hat; geometric_mean = sqrt(u_hat * p_hat)
# FINAL_SCORE_COMBINER=product
HYBRID_PREF_SIGMOID_FACTOR=2.646
HYBRID_PREF_VIGNETTES_FOR_FULL_CONFIDENCE=10
# HYBRID_PREF_SCHEMA_PATH=   # optional; defaults to job_attributes_schema (1).json

# Per-attribute toggles (true/false, 1/0, yes/no)
PREF_ENABLE_EARNINGS=true
PREF_ENABLE_TASK_CONTENT=false
PREF_ENABLE_PHYSICAL_DEMAND=true
PREF_ENABLE_WORK_FLEXIBILITY=false
PREF_ENABLE_SOCIAL=true
PREF_ENABLE_CAREER_GROWTH=true
PREF_ENABLE_SOCIAL_MEANING=false

# --- Data files (defaults under backend/resources/; set absolute paths in production) ---
# Per-language under resources/occupations/<lang>/; falls back to en (the file is keyed on
# ISCO codes and work activities, so only its labels are language-specific).
# OCCUPATION_JSON_PATH=resources/occupations/en/combined_occupation_database_with_wa.json
#
# Skill embedding artefact. Default: gemini-embedding-001 over preferredLabel
# + description (encodes semantic concept similarity), 3072-dim fp16.
# EMBEDDING_MODEL_PATH=resources/models/skill_embedding_model_gemini.pt
#
# Alternative: legacy Node2Vec graph-walk over the ESCO taxonomy (encodes
# ESCO-graph adjacency rather than semantic similarity), 64-dim fp32. Row
# order is shared with the Gemini artefact, so SKILL_TO_ROW_PATH is unchanged.
# EMBEDDING_MODEL_PATH=resources/models/skill_embedding_model.pt
#
# Threshold note: GATE_SIMILARITY_THRESHOLD, SKILL_U_TAU_ELIG, and
# SKILL_ESSENTIAL_DAMPING_ALPHA were originally tuned against the Node2Vec
# score distribution. Gemini produces sharper, more bimodal cosines (true
# matches near 1.0, true mismatches near 0.0), which makes the existing
# thresholds more conservative than they need to be. Recalibrate against
# the new distribution before claiming production-tuned settings.
# SKILL_TO_ROW_PATH=resources/models/skill_to_row.json
#
# Taxonomy label packs live per language under resources/skill_taxonomy/<lang>/ and are
# picked automatically. Setting any of these pins ALL languages to one file — useful for a
# script that deliberately wants a single pack, wrong for a deployment: pinning them to a
# non-canonical pack takes the CANONICAL id space with it, so no label resolves, every posting
# reports zero essential-coverage and /match_v4 returns final_score 0.0. The resolver now logs
# an ERROR and ignores such a pin, but leave these empty in any deployment.
# SKILLS_CSV_PATH=resources/skill_taxonomy/en/skills.csv
# SKILL_GROUPS_CSV_PATH=resources/skill_taxonomy/en/skill_groups.csv
# SKILL_HIERARCHY_CSV_PATH=resources/skill_taxonomy/en/skill_hierarchy.csv

# --- Njila prep script (prep_njila_for_matching.py) ---
# Read Compass collections from Mongo instead of JSON exports:
# NJILA_PREP_SOURCE=mongo
# Optional: separate Mongo URI for Njila source data (overrides MONGO_URL for this script only):
# NJILA_PREP_SOURCE_DB_URI=mongodb://...
# Database name (defaults to compass-application-njila if unset):
# NJILA_MONGO_DB=compass-application-njila
# Optional collection name overrides if they differ in your cluster:
# NJILA_COLL_EXPLORE=explore_experiences_director_state
# NJILA_COLL_USER_PREFERENCES=user_preferences
# NJILA_COLL_JOB_PREFERENCES=job_preferences
# NJILA_COLL_PLAIN_PERSONAL=plain_personal_data
# NJILA_COLL_PROGRAMME_SKILLS=programme_skills
# JSON file mode: directory containing the five compass-application-njila.*.json files
# NJILA_JSON_INPUT_DIR=data/njila_supply_side
# Output JSONL path (default data/njila_match_input.jsonl under repo root)
# NJILA_OUTPUT_JSONL=data/njila_match_input.jsonl

# --- Harambee prep script (data/harambee/prep_harambee_for_matching.py) ---
# URI must match the variable name already used in team .env files (capital H):
# Harambee_PREP_SOURCE_DB_URI=mongodb+srv://...
# HARAMBEE_PREP_SOURCE=mongo
# HARAMBEE_MONGO_DB=Harambee
# Optional collection overrides (defaults match Njila / Compass layout):
# HARAMBEE_COLL_EXPLORE=explore_experiences_director_state
# HARAMBEE_COLL_USER_PREFERENCES=user_preferences
# HARAMBEE_COLL_JOB_PREFERENCES=job_preferences
# HARAMBEE_COLL_PLAIN_PERSONAL=plain_personal_data
# HARAMBEE_COLL_PROGRAMME_SKILLS=programme_skills
# File mode: directory + JSON export filename prefix (five files):
# HARAMBEE_JSON_INPUT_DIR=data/harambee_supply_side
# HARAMBEE_JSON_PREFIX=compass-application-harambee
# HARAMBEE_OUTPUT_JSONL=data/harambee/harambee_match_input.jsonl

# --- Kenya prep script (data/kenya/prep_kenya_for_matching.py) ---
# Mixed-case names match team .env (same pattern as Harambee_PREP_SOURCE_DB_URI):
# Kenya_PREP_SOURCE_DB_URI=mongodb+srv://...
# Kenya_PREP_SOURCE=mongo
# Kenya_MONGO_DB=compass-application-swahilipot
# ALL_CAPS aliases also work: KENYA_PREP_SOURCE_DB_URI, KENYA_MONGO_DB, etc.
# KENYA_OUTPUT_JSONL=data/kenya/kenya_match_input.jsonl

# --- /match_v4 skill gate & Phase-2 ranking (defaults live in app/config.py) ---
# Per-skill cosine bar (whitened+rescaled scale) for an essential skill to count as "met".
# V4_FULL_SIM_THRESHOLD=0.45
# Min essential-coverage share for is_eligible=True. Recalibrated 2026-06-18 (0.5 -> 0.38) so the
# typical genuine in-field match (mean coverage ~0.39) qualifies; raise it for a stricter gate.
# V4_FULL_MIN_ESS_SHARE=0.38
# Ranking coverage for postings with NO parsed essential skills. -1 (default) = use the live mean of
# the user's parsed-job coverages (treat unparsed as a typical job); a value in [0,1] fixes it
# (1.0 = old demotion-free behaviour). Stops unparsed white-collar jobs dominating the top.
# V4_FULL_UNPARSED_COVERAGE=-1
# Floor under the coverage demotion: coverage_factor = floor + (1-floor) * coverage ** gamma. Keeps a
# zero-coverage candidate demoted rather than annihilated — un-floored it scored final_score 0.0
# exactly, so the whole list tied at 0 and the u_hat x p_hat ordering was lost. 0 = un-floored.
# V4_FULL_COVERAGE_FLOOR=0.05

# --- /match_v4 tiered urban-pull location matching (defaults in app/config.py) ---
# When on, a user's pool is widened to their hub chain (local -> regional hub -> national hub) and v4
# opportunities are softly re-ranked by location tier. Set 0 to fully restore strict same-county matching.
# LOCATION_TIER_ENABLED=1
# Soft tier weights (final_score multipliers): local=1.0, regional hub=W_REGIONAL, national hub=W_NATIONAL,
# off-chain=0. Lower = stronger local preference (national 0.50 => a national job needs ~2x better fit).
# LOCATION_TIER_W_REGIONAL=0.70
# LOCATION_TIER_W_NATIONAL=0.50
# County -> hub-chain exceptions JSON (every other county defaults to [self, national_hub]).
# LOCATION_HUB_CHAINS_PATH=resources/location/location_hub_chains.json

# --- Request tracing (Langfuse) — see README "Request tracing" ---------------------------
# One trace per /match* request: per-stage spans (retrieval, embedding, shortlist, rerank,
# preference_scoring, formatting, skill_gaps) and one `embedding` per Gemini call (tokens,
# attempts, retries, failure). Off by default; a deployment with no keys runs exactly as before.
MATCHING_ENABLE_TRACING=0
# MATCHING_LANGFUSE_HOST=https://cloud.langfuse.com
# MATCHING_LANGFUSE_PUBLIC_KEY=pk-lf-
# Secret: provision via GitHub secrets / a secret store, never commit it.
# MATCHING_LANGFUSE_SECRET_KEY=sk-lf-
# (The keys and host also fall back to the SDK's own LANGFUSE_PUBLIC_KEY / _SECRET_KEY / _HOST.)
# The deployment name (IaC sets it to the Pulumi stack: dev, shp, zmb, sa, eth, …).
# MATCHING_TRACING_ENVIRONMENT=dev
# Defaults to Cloud Run's K_REVISION.
# MATCHING_TRACING_RELEASE=
# Tunables (camelCase JSON). recordEmbeddingInput exports the (masked) text sent to Gemini —
# the jobseeker's skill profile — so leave it false unless a deployment explicitly allows it.
# MATCHING_TRACING_CONFIG={"sampleRate": 1.0, "recordEmbeddingInput": false, "maskPii": true, "maxPayloadChars": 10000}
